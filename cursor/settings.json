  "accessibility.signals.voiceRecordingStarted": {
    "sound": "off",
  },
  "accessibility.signals.voiceRecordingStopped": {
    "sound": "off",
  },
  "git.confirmSync": false,
  "security.promptForLocalFileProtocolHandling": false,
  "diffEditor.renderSideBySide": true,
  "cursor.general.globalCursorIgnoreList": [
    "**/.env",
    "**/credentials.json",
    "**/credentials.*.json",
    "**/secret.json",
    "**/secrets.json",
    "**/*.key",
    "**/*.pem",
    "**/*.pfx",
    "**/*.p12",
    "**/*.crt",
    "**/*.cer",
    "**/id_rsa",
    "**/id_dsa",
    "**/.ssh/id_*",
  ],
  "remote.SSH.remotePlatform": {
    "do-droplet": "linux",
    "do-keycloak": "linux",
    "do-gram": "linux",
  },
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "cursor.enable_git_worktrees_setting": true,
  "cursor.agent_layout_browser_beta_setting": true,
  "cursor.cpp.disabledLanguages": ["plaintext"],
  "claudeCode.preferredLocation": "panel",
  "cursor.cpp.enablePartialAccepts": true,
  "workbench.editorAssociations": {
    "file:/**/*.xlsx": "jupyter-data-wrangler",
  },
  "explorer.confirmDragAndDrop": false,
  "git.replaceTagsWhenPull": true,
  "window.autoDetectColorScheme": false,
  "vs-kubernetes": {
    "vscode-kubernetes.helm-path-mac": "/Users/seranshanmugathas/.vs-kubernetes/tools/helm/darwin-arm64/helm",
    "vscode-kubernetes.kubectl-path-mac": "/Users/seranshanmugathas/.vs-kubernetes/tools/kubectl/kubectl",
    "vscode-kubernetes.minikube-path-mac": "/Users/seranshanmugathas/.vs-kubernetes/tools/minikube/darwin-arm64/minikube"
  },
}
