# ~/.ssh/config
#
# CONFIG ONLY. No private key material is ever committed to this repository.
# The repo .gitignore denies ssh/.ssh/* and re-admits only this file, so a
# newly generated key cannot leak by default.
#
# Private keys live in a real ~/.ssh directory outside any git worktree.

# ─── Machine-local hosts ─────────────────────────────────────────────────────
# Servers, IPs and usernames live in ~/.ssh/config.local, which is gitignored.
# An address is not a secret, but publishing one with its username hands out
# half of every brute-force attempt. Template: setup/ssh-config.local.example.
#
# This MUST be the first directive. An Include that appears after a `Host`
# line is scoped to that block and its own Host blocks are parsed but never
# applied; ssh -vvv reports it as "(parse only)". Relative paths resolve
# against ~/.ssh; a missing file is silently skipped.
Include config.local

# ─── Defaults for every host ─────────────────────────────────────────────────
Host *
  # Load the key into ssh-agent on first use, and store the passphrase in the
  # macOS Keychain so it is not re-prompted every session.
  AddKeysToAgent yes
  UseKeychain yes

  # Offer only the keys explicitly named for a host. Without this, ssh presents
  # every key in the agent, which can trip server auth-attempt limits.
  IdentitiesOnly yes

  # Reuse a single TCP connection for additional sessions to the same host.
  ControlMaster auto
  ControlPath ~/.ssh/control/%C
  ControlPersist 10m

  ServerAliveInterval 60
  ServerAliveCountMax 3

# ─── GitHub ──────────────────────────────────────────────────────────────────
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  PreferredAuthentications publickey
