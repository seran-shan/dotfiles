# Template for ~/.ssh/config.local. Copy, then edit:
#
#   cp setup/ssh-config.local.example ~/.ssh/config.local
#   chmod 600 ~/.ssh/config.local
#
# The real file is gitignored. ~/.ssh/config pulls it in with `Include`, so
# hosts here get the `Host *` defaults (agent, keychain, connection reuse).
#
# Server addresses and usernames stay out of the public repository.

# Host my-server
#   HostName 203.0.113.10
#   User me
#   IdentityFile ~/.ssh/id_ed25519
